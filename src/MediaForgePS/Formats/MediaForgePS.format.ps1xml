<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Dadstart.Labs.MediaForge.Models.MediaFile</Name>
      <ViewSelectedBy>
        <TypeName>Dadstart.Labs.MediaForge.Models.MediaFile</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Path</Label>
            <Width>40</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Format</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Duration</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Size</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Streams</Label>
            <Width>8</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Chapters</Label>
            <Width>8</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Path</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Format.Format</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Format.Duration</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Format.Size</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Streams.Count</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Chapters.Count</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>Dadstart.Labs.MediaForge.Models.MediaFormat</Name>
      <ViewSelectedBy>
        <TypeName>Dadstart.Labs.MediaForge.Models.MediaFormat</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Path</Label>
            <Width>36</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Format</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Title</Label>
            <Width>20</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Duration</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Size</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>BitRate</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Streams</Label>
            <Width>8</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Path</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Format</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Title</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Duration</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Size</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>BitRate</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>StreamCount</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>Dadstart.Labs.MediaForge.Models.MediaStream</Name>
      <ViewSelectedBy>
        <TypeName>Dadstart.Labs.MediaForge.Models.MediaStream</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Index</Label>
            <Width>6</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Type</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Codec</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Profile</Label>
            <Width>14</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Language</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Title</Label>
            <Width>24</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Duration</Label>
            <Width>12</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Index</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Type</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Codec</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Profile</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Language</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($null -ne $_.Tags -and $_.Tags.ContainsKey('title')) { $_.Tags['title'] }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Duration</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>Dadstart.Labs.MediaForge.Models.MediaChapter</Name>
      <ViewSelectedBy>
        <TypeName>Dadstart.Labs.MediaForge.Models.MediaChapter</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Id</Label>
            <Width>8</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Title</Label>
            <Width>28</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>StartTime</Label>
            <Width>14</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>EndTime</Label>
            <Width>14</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Id</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Title</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>StartTime</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>EndTime</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>Dadstart.Labs.MediaForge.Models.AudioTrackMapping</Name>
      <ViewSelectedBy>
        <TypeName>Dadstart.Labs.MediaForge.Models.CopyAudioTrackMapping</TypeName>
        <TypeName>Dadstart.Labs.MediaForge.Models.EncodeAudioTrackMapping</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>SourceIndex</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>DestIndex</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Title</Label>
            <Width>24</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Mode</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Details</Label>
            <Width>28</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>SourceIndex</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>DestinationIndex</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Title</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.GetType().Name -eq 'EncodeAudioTrackMapping') { 'Encode' } else { 'Copy' }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.GetType().Name -eq 'EncodeAudioTrackMapping') {
                    '{0} {1}k {2}ch' -f $_.DestinationCodec, $_.DestinationBitrate, $_.DestinationChannels
                  } else {
                    'copy'
                  }
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>Dadstart.Labs.MediaForge.Models.VideoEncodingSettings</Name>
      <ViewSelectedBy>
        <TypeName>Dadstart.Labs.MediaForge.Models.ConstantRateVideoEncodingSettings</TypeName>
        <TypeName>Dadstart.Labs.MediaForge.Models.VariableRateVideoEncodingSettings</TypeName>
        <TypeName>Dadstart.Labs.MediaForge.Models.NvencVideoEncodingSettings</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Codec</Label>
            <Width>14</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Preset</Label>
            <Width>12</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>PixelFormat</Label>
            <Width>14</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>RateControl</Label>
            <Width>16</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>SinglePass</Label>
            <Width>10</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Codec</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Preset</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>PixelFormat</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  switch ($_.GetType().Name) {
                    'ConstantRateVideoEncodingSettings' { "CRF $($_.CRF)" }
                    'VariableRateVideoEncodingSettings' { "$($_.Bitrate)k" }
                    'NvencVideoEncodingSettings' { "CQ $($_.Cq)" }
                    default { $_.ToString() }
                  }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>IsSinglePass</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>Dadstart.Labs.MediaForge.Models.MediaConversionResult</Name>
      <ViewSelectedBy>
        <TypeName>Dadstart.Labs.MediaForge.Models.MediaConversionResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>OutputPath</Label>
            <Width>36</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>SizeReduction</Label>
            <Width>14</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>InputSize</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>OutputSize</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Duration</Label>
            <Width>10</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Status</Label>
            <Width>16</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>
                  [System.IO.Path]::GetFileName($_.OutputPath)
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($_.Status -ne 'Success' -or $null -eq $_.SizeReductionPercent) { 'n/a' }
                  elseif ($_.SizeReductionPercent -gt 0) { '{0:0.#}% smaller' -f $_.SizeReductionPercent }
                  elseif ($_.SizeReductionPercent -lt 0) { '{0:0.#}% larger' -f [math]::Abs($_.SizeReductionPercent) }
                  else { 'same size' }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  '{0:0.0} MB' -f $_.InputSizeMegabytes
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  '{0:0.0} MB' -f $_.OutputSizeMegabytes
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  $t = $_.ProcessingTime
                  if ($t.TotalHours -ge 1) { '{0}:{1:D2}:{2:D2}' -f [int]$t.TotalHours, $t.Minutes, $t.Seconds }
                  else { '{0:D2}:{1:D2}' -f [int]$t.TotalMinutes, $t.Seconds }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Status</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Dadstart.Labs.MediaForge.Models.MediaConversionStatistics</Name>
      <ViewSelectedBy>
        <TypeName>Dadstart.Labs.MediaForge.Models.MediaConversionStatistics</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Files</Label>
            <Width>8</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>AvgSizeReduction</Label>
            <Width>16</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>AvgInputSize</Label>
            <Width>13</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>AvgOutputSize</Label>
            <Width>14</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>AvgDuration</Label>
            <Width>12</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>FileCount</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -eq $_.AverageSizeReductionPercent) { 'n/a' }
                  elseif ($_.AverageSizeReductionPercent -gt 0) { '{0:0.#}% smaller' -f $_.AverageSizeReductionPercent }
                  elseif ($_.AverageSizeReductionPercent -lt 0) { '{0:0.#}% larger' -f [math]::Abs($_.AverageSizeReductionPercent) }
                  else { 'same size' }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  '{0:0.0} MB' -f $_.AverageInputSizeMegabytes
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  '{0:0.0} MB' -f $_.AverageOutputSizeMegabytes
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  $t = $_.AverageProcessingTime
                  if ($t.TotalHours -ge 1) { '{0}:{1:D2}:{2:D2}' -f [int]$t.TotalHours, $t.Minutes, $t.Seconds }
                  else { '{0:D2}:{1:D2}' -f [int]$t.TotalMinutes, $t.Seconds }
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Dadstart.Labs.MediaForge.Models.SubtitleProcessingResult</Name>
      <ViewSelectedBy>
        <TypeName>Dadstart.Labs.MediaForge.Models.SubtitleProcessingResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>ExtractedCount</Label>
            <Width>14</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ConvertedCount</Label>
            <Width>14</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ExtractedPaths</Label>
            <Width>36</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ConvertedPaths</Label>
            <Width>36</Width>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>ExtractedCount</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ConvertedCount</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -eq $_.ExtractedPaths -or $_.ExtractedPaths.Count -eq 0) { '' }
                  else { ($_.ExtractedPaths | ForEach-Object { [System.IO.Path]::GetFileName($_) }) -join ', ' }
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -eq $_.ConvertedPaths -or $_.ConvertedPaths.Count -eq 0) { '' }
                  else { ($_.ConvertedPaths | ForEach-Object { [System.IO.Path]::GetFileName($_) }) -join ', ' }
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
